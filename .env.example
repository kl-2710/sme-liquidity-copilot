# Required only to run the OpenAI-backed parts of the agent (narrative LLM draft and Tier-2 drafts).
# Without a key the diagnosis still works: the deterministic English narrative is used.
OPENAI_API_KEY=your_openai_api_key_here

# UC-01 data source. Relative paths are resolved from the project folder.
# Leave empty to auto-detect: data/uc1_workbook.xlsx, otherwise the first .xlsx file in data/.
UC1_WORKBOOK_PATH=
# Keep true unless you have independently verified the workbook contains real company data.
UC1_DATA_IS_SYNTHETIC=true
